  "description": "Typed native PS5 API for ProsperoKit apps (app, notify, ime, pad, audio, fs, system, http)",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamGoodApp/prosperokit.git",
    "directory": "packages/native"
  },
  "homepage": "https://github.com/AdamGoodApp/prosperokit/tree/main/packages/native#readme",
  "bugs": {

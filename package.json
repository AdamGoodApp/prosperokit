{
  "name": "prosperokit-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "ProsperoKit: a native PS5 homebrew framework (React + TanStack Start + Rust engine)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 build",
    "typecheck": "tsc -b",
    "lint": "biome check . && pnpm --filter prosperokit-template-app lint",
    "format": "biome format --write . && pnpm --filter prosperokit-template-app format",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
